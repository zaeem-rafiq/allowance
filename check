#!/bin/bash
# Runs every check: the secret scan, the feature map, lint, types, unit tests, build,
# and the browser tests. Exits non-zero as soon as any check fails.
set -euo pipefail
cd "$(dirname "$0")"
export NEXT_TELEMETRY_DISABLED=1
# One run at a time per checkout: several Claude sessions can share this folder, and two runs at
# once would fight over the browser tests' port (3101) and build folder. A run waits up to ten
# minutes for the one before it; a lock left by a run that was killed is taken over.
LOCK="$(git rev-parse --git-dir)/allowance-check.lock"
waited=0
until mkdir "$LOCK" 2>/dev/null; do
  holder="$(cat "$LOCK/pid" 2>/dev/null || echo "")"
  if [ -n "$holder" ] && ! kill -0 "$holder" 2>/dev/null; then
    rm -f "$LOCK/pid"
    rmdir "$LOCK" 2>/dev/null || true
    continue
  fi
  if [ "$waited" -ge 600 ]; then
    echo "check: another ./check run has held the lock for 10 minutes ($LOCK). Stop it, then run again." >&2
    exit 1
  fi
  [ "$waited" -eq 0 ] && echo "check: waiting for another ./check run in this folder to finish..."
  sleep 2
  waited=$((waited + 2))
done
echo $$ > "$LOCK/pid"
trap 'rm -f "$LOCK/pid"; rmdir "$LOCK" 2>/dev/null' EXIT
# Secret scan (gitleaks): no password or key in saved history, staged edits, unsaved edits,
# or new files not yet added to git. -v names the file, line and rule; --redact hides the value.
gitleaks git -v --no-banner --redact --log-level warn .
gitleaks git -v --pre-commit --staged --no-banner --redact --log-level warn .
gitleaks git -v --pre-commit --no-banner --redact --log-level warn .
git ls-files --others --exclude-standard -z | xargs -0 -r -n1 gitleaks dir -v --no-banner --redact --log-level warn --
# Feature map: the checker first proves itself on fixtures that the installed test runners list
# from a scratch folder, then asks Playwright (and Vitest, for unit tests a row names) which tests
# exist and checks that every row has a proof and every end-to-end test has a row. It is told
# the Playwright config that `npm run e2e` below runs; any other playwright.config.* fails it.
scripts/check-features --self-test
scripts/check-features playwright.config.ts
npm run lint
npm run typecheck
npm test
npm run build
npm run e2e
